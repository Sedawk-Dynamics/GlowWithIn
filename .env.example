# --- Public ------------------------------------------------------------------
# The Next.js brand site origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://glowwithin.co.in
# The WooCommerce origin. Every shop / cart / checkout / account link points here.
NEXT_PUBLIC_SHOP_URL=https://shop.glowwithin.co.in

# --- Server only (contact form mail) ----------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GlowWithin <info@glowwithin.co.in>"
CONTACT_TO=info@glowwithin.co.in

# Shared secret for the WooCommerce "product updated" webhook -> /api/revalidate
WOO_WEBHOOK_SECRET=
